{
  "name": "groovbox",
  "displayName": "Groovbox",
  "description": "Gruvbox for VS Code. A modern take on Tom Philbin's Gruvbox Themes, with the full UI and semantic highlighting.",
  "version": "0.1.10",
  "publisher": "mafflin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mafflin/groovbox.git"
  },
  "homepage": "https://github.com/mafflin/groovbox#readme",
  "bugs": {
    "url": "https://github.com/mafflin/groovbox/issues"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "gruvbox",
    "vim",
    "retro",
    "dark",
    "light",
    "theme",
    "color-theme"
  ],
  "galleryBanner": {
    "color": "#282828",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Groovbox Dark Hard",
        "uiTheme": "vs-dark",
        "path": "./themes/groovbox-dark-hard.json"
      },
      {
        "label": "Groovbox Dark Medium",
        "uiTheme": "vs-dark",
        "path": "./themes/groovbox-dark-medium.json"
      },
      {
        "label": "Groovbox Dark Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/groovbox-dark-soft.json"
      },
      {
        "label": "Groovbox Light Hard",
        "uiTheme": "vs",
        "path": "./themes/groovbox-light-hard.json"
      },
      {
        "label": "Groovbox Light Medium",
        "uiTheme": "vs",
        "path": "./themes/groovbox-light-medium.json"
      },
      {
        "label": "Groovbox Light Soft",
        "uiTheme": "vs",
        "path": "./themes/groovbox-light-soft.json"
      }
    ]
  },
  "scripts": {
    "build": "node src/build.js",
    "vscode:prepublish": "node src/build.js",
    "package": "npx --yes @vscode/vsce package",
    "publish:vscode": "npx --yes @vscode/vsce publish",
    "publish:openvsx": "npx --yes ovsx publish"
  }
}
