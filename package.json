{
  "name": "groovbox",
  "displayName": "Groovbox",
  "description": "Gruvbox for VS Code, with code colors from Brian Reilly's Sublime port, plus the full UI and semantic highlighting.",
  "version": "0.2.5",
  "publisher": "mafflin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mafflin/groovbox.git"
  },
  "homepage": "https://github.com/mafflin/groovbox#readme",
  "bugs": {
    "url": "https://github.com/mafflin/groovbox/issues"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "gruvbox",
    "vim",
    "retro",
    "dark",
    "light",
    "theme",
    "color-theme"
  ],
  "galleryBanner": {
    "color": "#282828",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "id": "Groovbox Dark Medium",
        "label": "Groovbox Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/groovbox-dark.json"
      },
      {
        "id": "Groovbox Light Medium",
        "label": "Groovbox Light",
        "uiTheme": "vs",
        "path": "./themes/groovbox-light.json"
      }
    ]
  },
  "scripts": {
    "build": "node src/build.js",
    "screenshots": "node src/screenshots.js",
    "vscode:prepublish": "node src/build.js",
    "package": "npx --yes @vscode/vsce package",
    "publish:vscode": "npx --yes @vscode/vsce publish",
    "publish:openvsx": "npx --yes ovsx publish"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
